<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET serve SOLO a scaricare le immagini di personaggi, outfit ed eventi dal CDN di
         Super Mario Wiki (URL in seed/, estratti da tools/seedgen): non sono nel repository né
         nell'APK. Tutto il resto dell'app resta offline e funziona anche senza rete (SPEC §0.3):
         senza connessione si vedono i segnaposto con le iniziali. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".KartLogApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KartLog">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KartLog">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
